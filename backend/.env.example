# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Notificaciones web (módulo 5) ---
# Genera el par de llaves una sola vez:  npx web-push generate-vapid-keys
# La pública se comparte con el navegador; la privada NUNCA se sube al repositorio.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del emisor (mailto: o https://), lo exige el estándar Web Push.
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Secreto compartido con el job de recordatorios (pg_cron). Cualquier texto largo y aleatorio.
CRON_SECRET=

# --- PayU Latam WebCheckout (sandbox Colombia) ---
PAYU_MERCHANT_ID=
PAYU_API_LOGIN=
PAYU_API_KEY=
PAYU_PUBLIC_KEY=
PAYU_ACCOUNT_ID_CO=
PAYU_CHECKOUT_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu/
PAYU_QUERY_URL=https://sandbox.api.payulatam.com/reports-api/4.0/service.cgi
# Algoritmo de firma de notificación: HMAC-SHA256, SHA256, SHA1 o MD5.
PAYU_SIGNATURE_ALGORITHM=HMAC-SHA256
# Opcional: clave HMAC separada si PayU la configuró; por defecto usa PAYU_API_KEY.
PAYU_SIGNATURE_HMAC_KEY=
PAYU_CONFIRMATION_URL=
PAYU_RESPONSE_URL=
